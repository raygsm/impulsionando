# Copy to `.env.staging` (gitignored). Staging Supabase ONLY — ref kyiczxtcoexnvcqgrgkr
# Optional overrides: `.env.staging.local` (also gitignored; wins over `.env.local` in `dev:staging`)
# Dashboard → impulsionando-staging → Project Settings → API
# NEVER commit real keys. NEVER point prod apex/webhooks at these values.

APP_ENV=staging
NODE_ENV=development

# App + SSR (required)
SUPABASE_URL=https://kyiczxtcoexnvcqgrgkr.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite / browser (must match staging project)
VITE_SUPABASE_URL=https://kyiczxtcoexnvcqgrgkr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=kyiczxtcoexnvcqgrgkr

# Local public origin when running `npm run dev:staging`
VITE_PUBLIC_SITE_URL=http://localhost:8080
PUBLIC_SITE_URL=http://localhost:8080

# Ops only — pg_dump/pg_restore (optional; password from Database settings, not API keys)
# DB_HOST_STAGING=db.kyiczxtcoexnvcqgrgkr.supabase.co
# DB_PASSWORD_STAGING=
