# Phase 4B app-web — GHCR SHA image (staging strangler stub).

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/app-web/package.json apps/app-web/

RUN pnpm install --filter @impulsionando/app-web... --frozen-lockfile

COPY apps/app-web apps/app-web

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV APP_WEB_PORT=3320
EXPOSE 3320
CMD ["pnpm", "--filter", "@impulsionando/app-web", "start"]
