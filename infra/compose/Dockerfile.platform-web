# Phase 4B platform-web — GHCR SHA image (staging strangler stub).

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/platform-web/package.json apps/platform-web/

RUN pnpm install --filter @impulsionando/platform-web... --frozen-lockfile

COPY apps/platform-web apps/platform-web

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV PLATFORM_WEB_PORT=3310
EXPOSE 3310
CMD ["pnpm", "--filter", "@impulsionando/platform-web", "start"]
