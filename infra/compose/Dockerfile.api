# Phase 3 Nest Support API — GHCR SHA promote (staging only).
# Build context: repository root.

FROM node:22-alpine AS build
WORKDIR /app
# Pin pnpm 10: corepack default (11.x) enforces minimumReleaseAge on the monorepo lockfile.
RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/tenant-context/package.json packages/tenant-context/
COPY apps/api/package.json apps/api/

RUN pnpm install --filter @impulsionando/api... --frozen-lockfile

COPY packages/contracts packages/contracts
COPY packages/tenant-context packages/tenant-context
COPY apps/api apps/api

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}

# Contracts are TS-source ESM; run Nest via tsx for the pilot image.
WORKDIR /app
EXPOSE 3100
ENV API_PORT=3100
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@impulsionando/api", "start:prod"]
