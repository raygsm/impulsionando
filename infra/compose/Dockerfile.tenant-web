# Phase 4B tenant-web — GHCR SHA image (staging strangler stub).
# Build context: repository root.

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/tenant-host/package.json packages/tenant-host/
COPY apps/tenant-web/package.json apps/tenant-web/

RUN pnpm install --filter @impulsionando/tenant-web... --frozen-lockfile

COPY packages/tenant-host packages/tenant-host
COPY apps/tenant-web apps/tenant-web

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV TENANT_WEB_PORT=3300
EXPOSE 3300
CMD ["pnpm", "--filter", "@impulsionando/tenant-web", "start"]
