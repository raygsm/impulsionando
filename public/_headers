# Cache-busting: HTML e JSON sempre frescos; assets versionados mantem long-cache.
/*
  cache-control: public, max-age=0, must-revalidate
  x-build-commit: see /api/public/version

/index.html
  cache-control: no-store, must-revalidate

/api/*
  cache-control: no-store, must-revalidate

/assets/*
  cache-control: public, max-age=31536000, immutable
